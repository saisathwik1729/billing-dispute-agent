# Copy to .env for local runs. Never commit real values.

# Database. SQLite for local development; use Postgres in hosted environments
# (e.g. a free Neon database: postgresql://USER:PASSWORD@HOST/DB?sslmode=require).
DATABASE_URL=sqlite:///./data/app.db

# Language model. LLM_PROVIDER is one of: gemini | anthropic | openai | mock
#   gemini    -> Google Gemini free tier (default). Free key from https://aistudio.google.com
#   anthropic -> Anthropic Messages API (paid, pay-as-you-go)
#   openai    -> any OpenAI-compatible endpoint (OpenAI, Groq, OpenRouter) via LLM_BASE_URL
#   mock      -> offline, no key; for tests and local UI work only
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
LLM_API_KEY=
LLM_BASE_URL=
# Groq example (also free): LLM_PROVIDER=openai  LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=llama-3.3-70b-versatile
# Backup models tried in order when the main model is busy (429/5xx) or retired (404)
LLM_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash-lite
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=1

# Sign-in. Comma-separated username:password pairs, and a long random signing secret.
REVIEWER_ACCOUNTS=reviewer:change-me
AUTH_SECRET=replace-with-a-long-random-string

# Guards and demo behaviour
MAX_ANALYSIS_RUNS_PER_HOUR=40
ALLOW_FAILURE_SIMULATION=true
SEED_SAMPLE_CASES=true
LOG_LEVEL=INFO
